PORT=3001
# Origem(ns) liberada(s) no CORS pros endpoints públicos. Aceita uma lista separada por
# vírgula (sem espaço depois da vírgula não é obrigatório, é feito trim em cada uma). Em
# produção, inclua também localhost:3000 e 127.0.0.1:3000 — precisa dar pra testar os
# formulários com o frontend rodando local contra o backend de produção:
# FRONTEND_ORIGIN=https://academiabelfort.com.br,https://www.academiabelfort.com.br,http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN=http://localhost:3000

# URLs dos Web Apps do Google Apps Script (Extensões > Apps Script > Implantar > App da Web)
# É a mesma URL para as cinco (um único Web App, diferenciado pelo campo "tipo").
APPS_SCRIPT_URL_MATRICULA=
APPS_SCRIPT_URL_CORTESIA=
APPS_SCRIPT_URL_AVALIACAO=
APPS_SCRIPT_URL_AVALIACAO_NUTRICIONAL=
APPS_SCRIPT_URL_BANNERS=

# Mesmo valor de SHARED_SECRET definido em backend/apps-script/Code.gs
APPS_SCRIPT_SHARED_SECRET=

# Credenciais do Cloudinary (cloudinary.com, free tier) — usadas pra guardar as imagens dos
# banners. Dashboard → copia "Cloud name", "API Key" e "API Secret".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Conta Gmail usada para enviar o lembrete de aula (gerar em myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Login da área administrativa (POST /admin/login). Usuário único, compartilhado.
# Gere o hash com: node -e "console.log(require('bcrypt').hashSync('SUA_SENHA', 10))"
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Segredo usado para assinar o JWT devolvido pelo login admin — qualquer string aleatória longa.
JWT_SECRET=
